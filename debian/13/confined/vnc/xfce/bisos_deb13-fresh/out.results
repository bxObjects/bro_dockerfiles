#######  /Command Service (CS) Brief Usage/  ##########
dockerProc.spcs -i commonExamples    # Help, Model, icmOptionsExample
dockerProc.spcs -i describe | emlVisit
dockerProc.spcs -i examples | emlOutFilter.sh -i iimToEmlStdout  | emlVisit
dockerProc.spcs -i visit
emlVisit -v -n showRun -i gotoPanel ./dockerProc.spcs
#######  =CSXU Player Examples=  ##########
dockerProc.spcs -i inSchema  pdf-emacs
dockerProc.spcs -i playerMenu
#######  *containerProc — build, run, verify, compose, status, clean*  ##########
=======  Build  ==========
dockerProc.spcs -i containerProc_build           # build with layer cache
dockerProc.spcs -i containerProc_build --noCache="true"           # --no-cache build
=======  Docker compose (confined / privileged)  ==========
dockerProc.spcs -i containerProc_composeUp           # cgroup v2 host
dockerProc.spcs -i containerProc_composeUp --cgroupVer="v1"           # cgroup v1 host
dockerProc.spcs -i containerProc_composeDown
=======  Podman run (rootless-sysd)  ==========
dockerProc.spcs -i containerProc_run --detach="true"           # detached
=======  Verify  ==========
dockerProc.spcs -i containerProc_verify
=======  Status / Clean  ==========
dockerProc.spcs -i containerProc_status
dockerProc.spcs -i containerProc_clean
