# Podman Quadlet unit --- rootless, per-user.
#
# This is the multi-tenant "dev box per engineer" form. Each engineer drops
# this file at ~/.config/containers/systemd/bisos-deb13-rootless-sysd.container
# and manages it through their OWN user systemd:
#
#   systemctl --user daemon-reload
#   systemctl --user start  bisos-deb13-rootless-sysd
#   systemctl --user enable bisos-deb13-rootless-sysd   # start at login
#   loginctl enable-linger $USER                        # survive logout
#
# No root, no --privileged. Podman generates a transient .service from this.
# Ports below are per-variant defaults; each engineer must pick unique host
# ports (or sit behind a reverse proxy) when several run on one VM.

[Unit]
Description=BISOS deb13 rootless systemd VNC dev container

[Container]
Image=bisos/deb13-rootless-sysd-vnc-xfce:1
ContainerName=bisos-deb13-rootless-sysd

# Podman handles cgroup delegation + tmpfs for systemd. No --privileged.
RunInit=false
PublishPort=2226:22
PublishPort=5905:5901
PublishPort=6905:6901
Volume=%h/shuttle:/shuttle/this

[Service]
Restart=on-failure
TimeoutStartSec=90

[Install]
WantedBy=default.target
